# Переменные окружения для Health Monitor Bot
# Скопируйте этот файл в .env и заполните реальными значениями

# Токен Telegram бота (получите у @BotFather)
TOKEN=your_telegram_bot_token_here

# Необязательный HTTP(S)-прокси для всех запросов к Telegram API.
# Допускается авторизация в URL; спецсимволы в логине и пароле кодируйте как URL.
# PROXY_URL=http://username:password@proxy.example.com:3128

# Дополнительные настройки (опционально)
# LOG_LEVEL=INFO
# DATABASE_URL=sqlite:///app/measurements.db
